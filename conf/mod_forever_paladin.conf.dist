[worldserver]

########################################
# mod-forever-paladin
#
# Every paladin learns Holy Strike, whatever their spec, as in WoW Forever: an instant Holy
# weapon strike on the global cooldown, like Crusader Strike. Players need the client patch
# (tools/build_patch.py); without it their client treats the button as a next-swing attack.
########################################

#
#    ForeverPaladin.HolyStrike.Enable
#        Description: Master switch. With 0, paladins who learned Holy Strike lose it at their
#                     next login.
#        Default:     1
#

ForeverPaladin.HolyStrike.Enable = 1

#
#    ForeverPaladin.HolyStrike.Level
#        Description: Level at which paladins learn Holy Strike. Paladins below it lose it (for
#                     example after a GM lowers their level).
#        Default:     6
#

ForeverPaladin.HolyStrike.Level = 6

#
#    ForeverPaladin.HolyStrike.Cooldown
#        Description: Cooldown in milliseconds, starting when the swing happens (a miss or dodge
#                     still starts it). 0 for none.
#        Default:     12000
#

ForeverPaladin.HolyStrike.Cooldown = 12000

#
#    ForeverPaladin.HolyStrike.WeaponPercent
#    ForeverPaladin.HolyStrike.DamagePerLevel
#    ForeverPaladin.HolyStrike.AttackPowerCoefficient
#    ForeverPaladin.HolyStrike.SpellPowerCoefficient
#        Description: Holy Strike's damage, all Holy: this percent of a weapon hit, plus
#                     DamagePerLevel x the paladin's level, plus shares of attack power and Holy
#                     spell power. The defaults are WoW Forever's at level 60 (40% of weapon
#                     damage + 108 + 42.9% of spell power), with the flat part spread over the
#                     levels (Forever's rank 1 at level 6 adds 12): 144 at level 80. A level 80
#                     paladin with a 1293 weapon hit and 1200 spell power hits for about 1140.
#                     The client patch's tooltip uses the defaults.
#        Default:     40, 1.8, 0, 0.429
#

ForeverPaladin.HolyStrike.WeaponPercent = 40
ForeverPaladin.HolyStrike.DamagePerLevel = 1.8
ForeverPaladin.HolyStrike.AttackPowerCoefficient = 0
ForeverPaladin.HolyStrike.SpellPowerCoefficient = 0.429

#
#    ForeverPaladin.HolyStrike.ManaCostPercent
#        Description: Mana cost as a whole percentage of base mana, like Crusader Strike's 5%.
#                     That's about 6 mana at level 6, 75 at 60 and 220 at 80. 0 keeps the game
#                     data's flat 75. NPCs always pay 75. Without the optional client patch the
#                     tooltip says 75 Mana whatever this is set to; with it, the patch must use
#                     the same value (see tools/build_patch.py).
#        Default:     5
#

ForeverPaladin.HolyStrike.ManaCostPercent = 5

########################################
# Shield Specialization's mana return
#
# In WoW Forever, Shield Specialization gives blocks a chance to restore 6% of max mana, at most
# once every 3 seconds. 3.3.5 has no Shield Specialization (its block bonus is part of Redoubt), so
# paladins with Redoubt get it here, with the chance set per Redoubt rank, and it's a share of base
# mana instead of max mana. No client patch; the Redoubt tooltip doesn't mention it.
########################################

#
#    ForeverPaladin.ShieldMana.Enable
#        Description: Master switch. With 0, blocks never return mana.
#        Default:     1
#

ForeverPaladin.ShieldMana.Enable = 1

#
#    ForeverPaladin.ShieldMana.ChanceRank1
#    ForeverPaladin.ShieldMana.ChanceRank2
#    ForeverPaladin.ShieldMana.ChanceRank3
#        Description: Chance in percent that a block returns mana, with 1, 2 or 3 points in
#                     Redoubt. Paladins without Redoubt never get it.
#        Default:     33, 66, 100
#

ForeverPaladin.ShieldMana.ChanceRank1 = 33
ForeverPaladin.ShieldMana.ChanceRank2 = 66
ForeverPaladin.ShieldMana.ChanceRank3 = 100

#
#    ForeverPaladin.ShieldMana.BaseManaPercent
#        Description: Mana returned, as a percentage of base mana (not max mana, so Intellect
#                     doesn't raise it). 6% is about 8 mana at level 6, 91 at 60 and 264 at 80.
#        Default:     6
#

ForeverPaladin.ShieldMana.BaseManaPercent = 6

#
#    ForeverPaladin.ShieldMana.Cooldown
#        Description: Minimum time in milliseconds between two mana returns. A block that fails
#                     the chance roll doesn't start it.
#        Default:     3000
#

ForeverPaladin.ShieldMana.Cooldown = 3000

########################################
# Seal of Fury
#
# WoW Forever's tanking seal. Each melee hit deals extra Holy damage, like Seal of Righteousness;
# with a shield equipped it also grants Fury Ward, a small absorb. Judging it (Judgement of Fury)
# deals Holy damage and taunts the target for 4 seconds. Four new spells (90080-90083): players
# need patch-P with them (tools/build_patch.py), or the spell, its buff and its combat log lines
# are unknown to their client.
########################################

#
#    ForeverPaladin.SealOfFury.Enable
#        Description: Master switch. With 0, paladins who learned Seal of Fury lose it at their
#                     next login.
#        Default:     1
#

ForeverPaladin.SealOfFury.Enable = 1

#
#    ForeverPaladin.SealOfFury.Level
#        Description: Level at which paladins learn Seal of Fury. The client patch's tooltip
#                     doesn't show the level, so this needs no patch change.
#        Default:     10
#

ForeverPaladin.SealOfFury.Level = 10

#
#    ForeverPaladin.SealOfFury.AttackPowerCoefficient
#    ForeverPaladin.SealOfFury.SpellPowerCoefficient
#        Description: Holy damage per melee hit, per second of weapon speed, as a share of
#                     attack power and Holy spell power. The defaults are Seal of
#                     Righteousness': a 2.6 speed weapon with 4000 attack power and 1200 spell
#                     power adds 366 per hit. The client patch's tooltip uses the defaults.
#        Default:     0.022, 0.044
#

ForeverPaladin.SealOfFury.AttackPowerCoefficient = 0.022
ForeverPaladin.SealOfFury.SpellPowerCoefficient = 0.044

#
#    ForeverPaladin.SealOfFury.WardPercent
#        Description: Fury Ward absorbs this share of the Holy damage the hit really did. Only
#                     with a shield equipped. Wards don't stack: a bigger one replaces the
#                     current one, and every hit keeps it up for 10 more seconds. 0 for none.
#        Default:     50
#

ForeverPaladin.SealOfFury.WardPercent = 50

########################################
# Blessings, Judgements and glyphs
#
# As in WoW Forever, Blessings last 1 hour and Judgement debuffs 40 seconds. The glyphs that made
# Blessing of Might and Blessing of Wisdom last 20 minutes longer on yourself make them cheaper
# instead. All of it is server-side; patch-P only updates the tooltips.
########################################

#
#    ForeverPaladin.Blessings.Duration
#        Description: Duration in milliseconds of every Blessing and Greater Blessing (Might,
#                     Wisdom, Kings, Sanctuary). It must be a duration the client's
#                     SpellDuration.dbc has; 3600000 (1 hour) is. 0 keeps 10 minutes for
#                     Blessings and 30 for Greater Blessings.
#        Default:     3600000
#

ForeverPaladin.Blessings.Duration = 3600000

#
#    ForeverPaladin.Judgements.Duration
#        Description: Duration in milliseconds of the Judgement of Light, Judgement of Wisdom,
#                     Heart of the Crusader and Judgements of the Just debuffs. Judgement of
#                     Justice keeps 20 seconds. Must be in SpellDuration.dbc; 40000 is. 0 keeps
#                     20 seconds.
#        Default:     40000
#

ForeverPaladin.Judgements.Duration = 40000

#
#    ForeverPaladin.Glyphs.BlessingCostReduction
#        Description: Glyph of Blessing of Might and Glyph of Blessing of Wisdom make their
#                     Blessing and Greater Blessing this many percent cheaper, like Glyph of
#                     Blessing of Kings, instead of 20 minutes longer on yourself. 0 keeps the
#                     old 20 minutes. The client patch's tooltips say 50%.
#        Default:     50
#

ForeverPaladin.Glyphs.BlessingCostReduction = 50
